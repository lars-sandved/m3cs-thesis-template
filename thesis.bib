% =============================================================================
% Bibliography database
% -----------------------------------------------------------------------------
% This file holds all your bibliography entries in BibTeX format. Citation
% style is configured in main.tex (currently: APA via biblatex).
%
% Workflow tips:
%   - Use a reference manager (Zotero, Mendeley, Paperpile) and export to
%     BibTeX. Most managers can keep a .bib file in sync with your library.
%   - Use citation keys you can remember. The Zotero Better BibTeX
%     extension produces keys like authorTitleWordYear, which scale well
%     to large libraries.
%   - Standardise author names. The same author appearing as "K. Friston"
%     and "K. J. Friston" will be treated as different people by biblatex
%     and may produce ugly disambiguating initials in your in-text cites.
%   - For thesis-by-publication: aggregate all bib entries here, even if
%     individual paper-chapters were written with separate bib files.
%
% In-text citation commands:
%   \citet{key}              -> Author (Year)
%   \citep{key}              -> (Author, Year)
%   \citep[p.~42]{key}       -> (Author, Year, p. 42)
%   \citep[see][]{key}       -> (see Author, Year)
%   \citep{key1,key2}        -> (Author1, Year; Author2, Year)
%   \citeauthor{key}         -> Author
%   \citeyear{key}           -> Year
% =============================================================================

% Example entries — delete and replace with your own.

@article{exampleArticle2026,
  author  = {Surname, First M. and Coauthor, Second N.},
  title   = {Title of the article},
  journal = {Journal Name},
  volume  = {12},
  number  = {3},
  pages   = {100--120},
  year    = {2026},
  doi     = {10.1234/example.2026.001}
}

@book{exampleBook2024,
  author    = {Author, Single},
  title     = {Title of the Book},
  publisher = {Publisher},
  address   = {City},
  year      = {2024}
}

@incollection{exampleChapter2025,
  author    = {Surname, First M.},
  title     = {Title of the Chapter},
  booktitle = {Title of the Edited Volume},
  editor    = {Editor, A. and Editor, B.},
  publisher = {Publisher},
  address   = {City},
  pages     = {25--47},
  year      = {2025}
}

@online{examplePreprint2026,
  author = {Surname, First M.},
  title  = {Title of the preprint},
  date   = {2026},
  eprint = {2601.12345},
  eprinttype = {arXiv},
  url    = {https://arxiv.org/abs/2601.12345}
}
